# OS cruft
.DS_Store

# Generated build output (created by build.py — never hand-edited)
dist/

# Logs / scratch
*.log

# Python bytecode
__pycache__/
*.pyc

# Local, machine-specific tooling settings
.claude/settings.local.json

# storytest artifacts (regenerated by `storytest.py --transcript …`)
tests/last-transcript.md

# Claude chat/session exports saved into the repo root (local scratch — NEVER
# publish). Matches the export naming "YYYY-MM-DD-HHMMSS-….txt" in any year,
# so newly saved chats are ignored automatically the moment they're created.
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
